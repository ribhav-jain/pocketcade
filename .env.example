# Pocketcade: every variable here is optional and non-secret. Never put a secret in this or any .env file.
# A build with no .env file succeeds. Values are read at build time only (Server Components, next.config,
# build scripts); client code never reads them.

# Public GitHub repository URL for the footer, crash card and "Report a bug" links.
# Default: derived from the Vercel or GitHub Actions system variables; the links are hidden (with a build
# warning) when neither is available.
# NEXT_PUBLIC_REPO_URL=https://github.com/ribhav-jain/pocketcade

# Site origin for canonical links, the sitemap, robots.txt and JSON-LD. No trailing slash.
# Default: https://<VERCEL_PROJECT_PRODUCTION_URL> on Vercel, otherwise http://127.0.0.1:4173 (the local
# static server). Set it in the Vercel project once the site has its own domain.
# NEXT_PUBLIC_SITE_URL=https://<your-domain>

# Deployment flavour: production | preview.
# Default: preview when VERCEL_ENV=preview, otherwise production (CI and local builds mirror production).
# NEXT_PUBLIC_DEPLOY_ENV=production
