{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@pocketcade/playground", "dev"],
      "port": 5173
    },
    {
      "name": "served",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve-static.ts",
        "--dir",
        "apps/web/out",
        "--config",
        "apps/web/vercel.json",
        "--port",
        "4180"
      ],
      "port": 4180
    }
  ]
}
